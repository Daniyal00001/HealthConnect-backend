  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "role": {
            "type": "string",
            "example": "clinic_owner"
          },
          "status": {
            "type": "string",
            "example": "active"
          }
        }
      },
      "Clinic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clinic_1"
          },
          "name": {
            "type": "string",
            "example": "City Health Center"
          },
          "address": {
            "type": "string",
            "example": "123 Main Street, Lahore"
          },
          "phone": {
            "type": "string",
            "example": "+92-300-1234567"
          },
          "email": {
            "type": "string",
            "example": "info@cityhealthcenter.com"
          },
          "status": {
            "type": "string",
            "example": "active"
          }
        }
      },
      "Doctor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "doc_1"
          },
          "name": {
            "type": "string",
            "example": "Dr. Ahmed Khan"
          },
          "email": {
            "type": "string",
            "example": "ahmed@clinic.com"
          },
          "phone": {
            "type": "string",
            "example": "+92-321-9876543"
          },
          "specialization": {
            "type": "string",
            "example": "Cardiology"
          },
          "consultationFee": {
            "type": "number",
            "example": 2000
          },
          "experience": {
            "type": "number",
            "example": 10
          },
          "status": {
            "type": "string",
            "example": "active"
          }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "patient_1"
          },
          "name": {
            "type": "string",
            "example": "Ali Hassan"
          },
          "age": {
            "type": "number",
            "example": 35
          },
          "gender": {
            "type": "string",
            "example": "male"
          },
          "phone": {
            "type": "string",
            "example": "+92-300-9876543"
          },
          "email": {
            "type": "string",
            "example": "ali@example.com"
          },
          "address": {
            "type": "string",
            "example": "House 45, Block C, Lahore"
          }
        }
      },
      "Appointment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "appt_1"
          },
          "patientId": {
            "type": "string",
            "example": "patient_1"
          },
          "doctorId": {
            "type": "string",
            "example": "doc_1"
          },
          "date": {
            "type": "string",
            "example": "2025-11-10"
          },
          "time": {
            "type": "string",
            "example": "10:00"
          },
          "reason": {
            "type": "string",
            "example": "Regular checkup"
          },
          "status": {
            "type": "string",
            "example": "scheduled"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Error message"
          },
          "code": {
            "type": "string",
            "example": "ERROR_CODE"
          }
        }
      }
    },
